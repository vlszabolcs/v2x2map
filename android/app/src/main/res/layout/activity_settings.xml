<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/settings_title"
            app:navigationIcon="@drawable/ic_back"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Display -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/display_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keep_screen_on_label"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dark_mode_label"/>

            <!-- Auto-Follow -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/follow_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/follow_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/follow_hint"/>

            <!-- Geiger-counter audio -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/audio_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/audio_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/audio_hint"/>

            <!-- SPATEM traffic light -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/spat_light_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSpatLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/spat_light_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/spat_light_hint"/>

            <!-- MQTT -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/mqtt_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMqtt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mqtt_enable"/>

            <!-- Dynamic broker address list — rows added/removed programmatically -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:text="@string/mqtt_broker_label"
                android:textSize="12sp"
                android:alpha="0.7"/>

            <LinearLayout
                android:id="@+id/brokerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBroker"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mqtt_add_broker"
                app:icon="@drawable/ic_add"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/mqtt_node_label">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edNodeId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMqttFilter"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mqtt_filter_btn"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/mqtt_filter_hint"/>

            <!-- Recording -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/rec_section"/>

            <TextView
                android:id="@+id/recStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rec_status_idle"
                android:textSize="13sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecord"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/rec_off"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recs_open"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAutoRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rec_auto_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/rec_auto_hint"/>

            <!-- Receiver position / background -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/receiver_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swReceiverGnss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/receiver_gnss_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/receiver_gnss_hint"/>

            <TextView
                android:id="@+id/batteryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattery"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/battery_button"/>

            <!-- Map -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/map_section"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:hint="@string/marker_ttl_label">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edMarkerTtl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/marker_ttl_hint"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadMap"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dl_map"/>

            <!-- Own track -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/own_track_section"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/near_setting_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/near_setting_hint"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swOwnTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/own_track_label"/>

            <TextView
                style="@style/Section.Hint"
                android:text="@string/own_track_hint"/>

            <!-- BLE Coex -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/ble_section"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCycle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cycle_settings"/>

            <!-- Reset -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/reset"/>

            <!-- About -->
            <TextView
                style="@style/Section.Header"
                android:text="@string/about_section"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/about_link"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGithub"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/github_link"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
