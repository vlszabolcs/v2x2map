# LilyGO T-Dongle-C5 overlay — applied on top of the stock sdkconfig:
#   idf.py -B build-tdongle -D SDKCONFIG=build-tdongle/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig;sdkconfig.defaults.tdongle-c5" build

# Board
# CONFIG_BOARD_WAVESHARE_C5_WIFI6_KIT is not set
CONFIG_BOARD_LILYGO_T_DONGLE_C5=y
CONFIG_HW_VARIANT="custom"

# 16 MB flash (ESP32-C5HR8)
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"

# Status LED: onboard APA102 (DI=GPIO5, CI=GPIO4)
# CONFIG_STATUS_LED_WS2812 is not set
CONFIG_STATUS_LED_APA102=y
CONFIG_APA102_DATA_PIN=5
CONFIG_APA102_CLK_PIN=4
CONFIG_APA102_GLOBAL_BRIGHTNESS=4

# SD card (SPI, shared with the LCD): CMD/MOSI=2, D0/MISO=7, CLK=6, CS=23
CONFIG_ENABLE_SD=y
CONFIG_SNIFFER_SD_SPI_MODE=y
CONFIG_SNIFFER_PIN_MOSI=2
CONFIG_SNIFFER_PIN_MISO=7
CONFIG_SNIFFER_PIN_CLK=6
CONFIG_SNIFFER_PIN_CS=23

# 0.96" ST7735 status display
CONFIG_ENABLE_LCD=y
CONFIG_LCD_PIN_CS=10
CONFIG_LCD_PIN_DC=3
CONFIG_LCD_PIN_RST=1
CONFIG_LCD_PIN_BL=0
CONFIG_LCD_X_OFFSET=1
CONFIG_LCD_Y_OFFSET=26

# No W5500 Ethernet on the dongle (its CS/INT pins collide with LED/LCD)
# CONFIG_ETHERNET_SPI_SUPPORT is not set

# No LM75 — use the chip's internal temperature sensor instead
CONFIG_ENABLE_TEMPERATURE=y
# CONFIG_TEMPERATURE_LM75 is not set
CONFIG_TEMPERATURE_INTERNAL=y

# Button (BOOT, GPIO28): single = display, double = BLE window/off, long = reset
CONFIG_BUTTON_PIN=28
CONFIG_BLE_WINDOW_S=60

# Standalone SD logging; PCAP from the console also goes to the card
CONFIG_SDLOG_ENABLE=y
CONFIG_SDLOG_ROTATE_MB=16
CONFIG_SDLOG_ROTATE_MIN=60
CONFIG_SDLOG_MIN_FREE_MB=64
# CONFIG_SNIFFER_PCAP_DESTINATION_JTAG is not set
CONFIG_SNIFFER_PCAP_DESTINATION_SD=y
